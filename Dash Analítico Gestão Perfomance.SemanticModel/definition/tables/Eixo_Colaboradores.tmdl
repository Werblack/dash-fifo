	partition Eixo_Colaboradores = calculated
		mode: import
		source =
				
				VAR _ops_dim =
				    SELECTCOLUMNS(
				        FILTER(
				            ADDCOLUMNS(
				                DimColaboradores,
				                "__CargoNorm", SUBSTITUTE( UPPER( TRIM( DimColaboradores[Cargo] ) ), "Í", "I" ),
				                "__EhMatrizPolo",
				                    VAR _im  = DimColaboradores[IsMatriz] = TRUE()
				                    VAR _pb  = UPPER( TRIM( COALESCE( DimColaboradores[Polo_Base], "" ) ) )
				                    VAR _prh = UPPER( TRIM( COALESCE( DimColaboradores[Polo RH Site], "" ) ) )
				                    RETURN
				                        _im
				                        || _pb IN { "MATRIZ", "PAGRESOLVE MATRIZ SP" }
				                        || _prh IN { "MATRIZ", "PAGRESOLVE MATRIZ SP" }
				            ),
				            [__CargoNorm] IN { "TECNICO", "ASSISTENTE" }
				        ),
				        "Nome", DimColaboradores[Nome],
				        "Nome_Normalizado",
				            VAR n = UPPER( TRIM( DimColaboradores[Nome] ) )
				            VAR n1 =
				                SUBSTITUTE(
				                    SUBSTITUTE(
				                        SUBSTITUTE(
				                            SUBSTITUTE(
				                                SUBSTITUTE(
				                                    SUBSTITUTE(
				                                        SUBSTITUTE(
				                                            SUBSTITUTE(
				                                                SUBSTITUTE(
				                                                    SUBSTITUTE( n, "Á", "A" ),
				                                                    "À",
				                                                    "A"
				                                                ),
				                                                "Â",
				                                                "A"
				                                            ),
				                                            "Ã",
				                                            "A"
				                                        ),
				                                        "É",
				                                        "E"
				                                    ),
				                                    "Ê",
				                                    "E"
				                                ),
				                                "Í",
				                                "I"
				                            ),
				                            "Ó",
				                            "O"
				                        ),
				                        "Ô",
				                        "O"
				                    ),
				                    "Õ",
				                    "O"
				                )
				            RETURN
				                SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( n1, "Ú", "U" ), "Ü", "U" ), "Ç", "C" ),
				        "Cargo", DimColaboradores[Cargo],
				        "Matricula", DimColaboradores[Matricula],
				        "Polo_Base", DimColaboradores[Polo_Base],
				        "Polo Base (Regra)", IF( [__EhMatrizPolo], "Matriz", DimColaboradores[Polo_Base] ),
				        "IsMatriz", [__EhMatrizPolo],
				        "Grupo", "Operação",
				        "Fonte", "DIM"
				    )
				
				VAR _gest_matriz_dim =
				    SELECTCOLUMNS(
				        FILTER(
				            ADDCOLUMNS(
				                DimColaboradores,
				                "__CargoNorm", SUBSTITUTE( UPPER( TRIM( DimColaboradores[Cargo] ) ), "Í", "I" ),
				                "__EhMatriz",
				                    VAR _im  = DimColaboradores[IsMatriz] = TRUE()
				                    VAR _pb  = UPPER( TRIM( COALESCE( DimColaboradores[Polo_Base], "" ) ) )
				                    VAR _prh = UPPER( TRIM( COALESCE( DimColaboradores[Polo RH Site], "" ) ) )
				                    RETURN
				                        _im
				                        || _pb IN { "MATRIZ", "PAGRESOLVE MATRIZ SP" }
				                        || _prh IN { "MATRIZ", "PAGRESOLVE MATRIZ SP" }
				            ),
				            [__CargoNorm] IN { "LIDER", "COORDENADOR" } && [__EhMatriz]
				        ),
				        "Nome", DimColaboradores[Nome],
				        "Nome_Normalizado",
				            VAR n2 = UPPER( TRIM( DimColaboradores[Nome] ) )
				            VAR n2a =
				                SUBSTITUTE(
				                    SUBSTITUTE(
				                        SUBSTITUTE(
				                            SUBSTITUTE(
				                                SUBSTITUTE(
				                                    SUBSTITUTE(
				                                        SUBSTITUTE(
				                                            SUBSTITUTE(
				                                                SUBSTITUTE(
				                                                    SUBSTITUTE( n2, "Á", "A" ),
				                                                    "À",
				                                                    "A"
				                                                ),
				                                                "Â",
				                                                "A"
				                                            ),
				                                            "Ã",
				                                            "A"
				                                        ),
				                                        "É",
				                                        "E"
				                                    ),
				                                    "Ê",
				                                    "E"
				                                ),
				                                "Í",
				                                "I"
				                            ),
				                            "Ó",
				                            "O"
				                        ),
				                        "Ô",
				                        "O"
				                    ),
				                    "Õ",
				                    "O"
				                )
				            RETURN
				                SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( n2a, "Ú", "U" ), "Ü", "U" ), "Ç", "C" ),
				        "Cargo", DimColaboradores[Cargo],
				        "Matricula", DimColaboradores[Matricula],
				        "Polo_Base", "Matriz",
				        "Polo Base (Regra)", "Matriz",
				        "IsMatriz", TRUE(),
				        "Grupo", "Gestor",
				        "Fonte", "DIM (Matriz)"
				    )
				
				VAR _coords_factos_raw =
				    DISTINCT(
				        SELECTCOLUMNS(
				            FILTER(
				                FactOS,
				                NOT ISBLANK( FactOS[Coordenador.Coordenador] )
				                    && UPPER( TRIM( FactOS[Coordenador.Coordenador] ) ) <> "MATRIZ"
				                    && UPPER( TRIM( FactOS[Coordenador.Coordenador] ) ) <> ""
				            ),
				            "Nome", FactOS[Coordenador.Coordenador]
				        )
				    )
				
				VAR _coords_factos =
				    SELECTCOLUMNS(
				        ADDCOLUMNS(
				            _coords_factos_raw,
				            "__Matricula",
				                VAR nom = [Nome]
				                RETURN
				                    MAXX(
				                        FILTER(
				                            ALL( DimColaboradores ),
				                            SUBSTITUTE( UPPER( TRIM( DimColaboradores[Cargo] ) ), "Í", "I" ) = "COORDENADOR"
				                                && DimColaboradores[Nome] = nom
				                        ),
				                        DimColaboradores[Matricula]
				                    )
				        ),
				        "Nome", [Nome],
				        "Nome_Normalizado",
				            VAR nc = UPPER( TRIM( [Nome] ) )
				            VAR nc1 =
				                SUBSTITUTE(
				                    SUBSTITUTE(
				                        SUBSTITUTE(
				                            SUBSTITUTE(
				                                SUBSTITUTE(
				                                    SUBSTITUTE(
				                                        SUBSTITUTE(
				                                            SUBSTITUTE(
				                                                SUBSTITUTE(
				                                                    SUBSTITUTE( nc, "Á", "A" ),
				                                                    "À",
				                                                    "A"
				                                                ),
				                                                "Â",
				                                                "A"
				                                            ),
				                                            "Ã",
				                                            "A"
				                                        ),
				                                        "É",
				                                        "E"
				                                    ),
				                                    "Ê",
				                                    "E"
				                                ),
				                                "Í",
				                                "I"
				                            ),
				                            "Ó",
				                            "O"
				                        ),
				                        "Ô",
				                        "O"
				                    ),
				                    "Õ",
				                    "O"
				                )
				            RETURN
				                SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( nc1, "Ú", "U" ), "Ü", "U" ), "Ç", "C" ),
				        "Cargo", "Coordenador",
				        "Matricula", [__Matricula],
				        "Polo_Base", BLANK(),
				        "Polo Base (Regra)", BLANK(),
				        "IsMatriz", FALSE(),
				        "Grupo", "Gestor",
				        "Fonte", "FactOS (Coord)"
				    )
				
				VAR _liders_factos_raw =
				    DISTINCT(
				        SELECTCOLUMNS(
				            FILTER(
				                FactOS,
				                NOT ISBLANK( FactOS[Líder] )
				                    && UPPER( TRIM( FactOS[Líder] ) ) <> "MATRIZ"
				                    && UPPER( TRIM( FactOS[Líder] ) ) <> ""
				            ),
				            "Nome", FactOS[Líder]
				        )
				    )
				
				VAR _liders_factos =
				    SELECTCOLUMNS(
				        ADDCOLUMNS(
				            _liders_factos_raw,
				            "__Matricula",
				                VAR nom = [Nome]
				                RETURN
				                    MAXX(
				                        FILTER(
				                            ALL( DimColaboradores ),
				                            SUBSTITUTE( UPPER( TRIM( DimColaboradores[Cargo] ) ), "Í", "I" ) = "LIDER"
				                                && DimColaboradores[Nome] = nom
				                        ),
				                        DimColaboradores[Matricula]
				                    )
				        ),
				        "Nome", [Nome],
				        "Nome_Normalizado",
				            VAR nl = UPPER( TRIM( [Nome] ) )
				            VAR nl1 =
				                SUBSTITUTE(
				                    SUBSTITUTE(
				                        SUBSTITUTE(
				                            SUBSTITUTE(
				                                SUBSTITUTE(
				                                    SUBSTITUTE(
				                                        SUBSTITUTE(
				                                            SUBSTITUTE(
				                                                SUBSTITUTE(
				                                                    SUBSTITUTE( nl, "Á", "A" ),
				                                                    "À",
				                                                    "A"
				                                                ),
				                                                "Â",
				                                                "A"
				                                            ),
				                                            "Ã",
				                                            "A"
				                                        ),
				                                        "É",
				                                        "E"
				                                    ),
				                                    "Ê",
				                                    "E"
				                                ),
				                                "Í",
				                                "I"
				                            ),
				                            "Ó",
				                            "O"
				                        ),
				                        "Ô",
				                        "O"
				                    ),
				                    "Õ",
				                    "O"
				                )
				            RETURN
				                SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( nl1, "Ú", "U" ), "Ü", "U" ), "Ç", "C" ),
				        "Cargo", "Lider",
				        "Matricula", [__Matricula],
				        "Polo_Base", BLANK(),
				        "Polo Base (Regra)", BLANK(),
				        "IsMatriz", FALSE(),
				        "Grupo", "Gestor",
				        "Fonte", "FactOS (Líder)"
				    )
				
				VAR _dim_tecs_mats =
				    SELECTCOLUMNS(
				        FILTER(
				            ADDCOLUMNS(
				                DimColaboradores,
				                "__CargoNorm", SUBSTITUTE( UPPER( TRIM( DimColaboradores[Cargo] ) ), "Í", "I" )
				            ),
				            [__CargoNorm] = "TECNICO"
				        ),
				        "Matricula", DimColaboradores[Matricula]
				    )
				
				VAR _dim_assistentes_mats =
				    SELECTCOLUMNS(
				        FILTER(
				            ADDCOLUMNS(
				                DimColaboradores,
				                "__CargoNorm", SUBSTITUTE( UPPER( TRIM( DimColaboradores[Cargo] ) ), "Í", "I" )
				            ),
				            [__CargoNorm] = "ASSISTENTE"
				        ),
				        "Matricula", DimColaboradores[Matricula]
				    )
				
				VAR _mats_fact_os =
				    SELECTCOLUMNS(
				        FILTER( FactOS, NOT ISBLANK( FactOS[Matricula] ) ),
				        "Matricula", FactOS[Matricula]
				    )
				
				VAR _mats_fact_csat =
				    SELECTCOLUMNS(
				        FILTER( FactCSAT, NOT ISBLANK( FactCSAT[Matricula2] ) ),
				        "Matricula", FactCSAT[Matricula2]
				    )
				
				VAR _mats_fact_all =
				    DISTINCT( UNION( _mats_fact_os, _mats_fact_csat ) )
				
				VAR _mats_to_add =
				    EXCEPT( EXCEPT( _mats_fact_all, _dim_tecs_mats ), _dim_assistentes_mats )
				
				VAR _tecnicos_fatos_add_base =
				    ADDCOLUMNS(
				        _mats_to_add,
				        "__NomeDIM", LOOKUPVALUE( DimColaboradores[Nome], DimColaboradores[Matricula], [Matricula] ),
				        "__PoloDIM", LOOKUPVALUE( DimColaboradores[Polo_Base], DimColaboradores[Matricula], [Matricula] ),
				        "__Polo03",
				            VAR m = [Matricula]
				            VAR t_top =
				                CALCULATETABLE(
				                    TOPN(
				                        1,
				                        ADDCOLUMNS(
				                            SUMMARIZE( FactOS, FactOS[des_service_provider] ),
				                            "__Qtd", COUNTROWS( FactOS )
				                        ),
				                        [__Qtd],
				                        DESC
				                    ),
				                    FactOS[Matricula] = m
				                )
				            RETURN
				                MAXX( t_top, FactOS[des_service_provider] )
				    )
				
				VAR _tecnicos_fatos_add =
				    SELECTCOLUMNS(
				        _tecnicos_fatos_add_base,
				        "Nome", [__NomeDIM],
				        "Nome_Normalizado",
				            VAR base = COALESCE( [__NomeDIM], "MAT-" & [Matricula] )
				            VAR n4 = UPPER( TRIM( base ) )
				            VAR n4a =
				                SUBSTITUTE(
				                    SUBSTITUTE(
				                        SUBSTITUTE(
				                            SUBSTITUTE(
				                                SUBSTITUTE(
				                                    SUBSTITUTE(
				                                        SUBSTITUTE(
				                                            SUBSTITUTE(
				                                                SUBSTITUTE(
				                                                    SUBSTITUTE( n4, "Á", "A" ),
				                                                    "À",
				                                                    "A"
				                                                ),
				                                                "Â",
				                                                "A"
				                                            ),
				                                            "Ã",
				                                            "A"
				                                        ),
				                                        "É",
				                                        "E"
				                                    ),
				                                    "Ê",
				                                    "E"
				                                ),
				                                "Í",
				                                "I"
				                            ),
				                            "Ó",
				                            "O"
				                        ),
				                        "Ô",
				                        "O"
				                    ),
				                    "Õ",
				                    "O"
				                )
				            RETURN
				                SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( n4a, "Ú", "U" ), "Ü", "U" ), "Ç", "C" ),
				        "Cargo", "Técnico",
				        "Matricula", [Matricula],
				        "Polo_Base", [__PoloDIM],
				        "Polo Base (Regra)",
				            IF(
				                UPPER( TRIM( COALESCE( [__PoloDIM], [__Polo03], "" ) ) ) IN { "MATRIZ", "PAGRESOLVE MATRIZ SP" },
				                "Matriz",
				                COALESCE( [__PoloDIM], [__Polo03] )
				            ),
				        "IsMatriz", FALSE(),
				        "Grupo", "Operação",
				        "Fonte", "Fato (03/04 sem DIM)"
				    )
				
				VAR _union_all =
				    UNION(
				        _ops_dim,
				        _gest_matriz_dim,
				        _coords_factos,
				        _liders_factos,
				        _tecnicos_fatos_add
				    )
				RETURN
				    DISTINCT( _union_all )

	annotation PBI_Id = 6e88b328125d4170a91ce29606f91fa5

