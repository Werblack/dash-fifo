	column Coordenador =
			
			VAR PoloAtual = [Polo Base (Regra)]
			VAR PoloUpper = UPPER(TRIM(COALESCE(PoloAtual, "")))
			VAR CargoNorm = SUBSTITUTE(UPPER(TRIM(COALESCE([Cargo], ""))), "Í", "I")
			VAR EhMatriz = [IsMatriz] || PoloUpper = "MATRIZ" || PoloUpper = "PAGRESOLVE MATRIZ SP"
			VAR NomeAtual = [Nome]
			RETURN
			    IF(
			        EhMatriz,
			        "Matriz",
			        IF(
			            CargoNorm = "COORDENADOR",
			            NomeAtual,
			            IF(
			                CargoNorm = "LIDER",
			                CALCULATE(
			                    FIRSTNONBLANK(FactOS[Coordenador.Coordenador], 1),
			                    FILTER(ALL(FactOS), FactOS[Líder] = NomeAtual)
			                ),
			                IF(
			                    NOT ISBLANK(PoloAtual) && PoloAtual <> "",
			                    CALCULATE(
			                        FIRSTNONBLANK(FactOS[Coordenador.Coordenador], 1),
			                        FILTER(ALL(FactOS), FactOS[des_service_provider] = PoloAtual)
			                    ),
			                    BLANK()
			                )
			            )
			        )
			    )
		lineageTag: c6bd3505-000d-439f-b330-6ad2c87792ec
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Líder =
			
			VAR PoloAtual = [Polo Base (Regra)]
			VAR PoloUpper = UPPER(TRIM(COALESCE(PoloAtual, "")))
			VAR CargoNorm = SUBSTITUTE(UPPER(TRIM(COALESCE([Cargo], ""))), "Í", "I")
			VAR EhMatriz = [IsMatriz] || PoloUpper = "MATRIZ" || PoloUpper = "PAGRESOLVE MATRIZ SP"
			VAR NomeAtual = [Nome]
			RETURN
			    IF(
			        EhMatriz,
			        "Matriz",
			        IF(
			            CargoNorm = "COORDENADOR",
			            BLANK(),
			            IF(
			                CargoNorm = "LIDER",
			                NomeAtual,
			                IF(
			                    NOT ISBLANK(PoloAtual) && PoloAtual <> "",
			                    CALCULATE(
			                        FIRSTNONBLANK(FactOS[Líder], 1),
			                        FILTER(ALL(FactOS), FactOS[des_service_provider] = PoloAtual)
			                    ),
			                    BLANK()
			                )
			            )
			        )
			    )
		lineageTag: 075ed844-739d-48e8-b24c-f6def7de4266
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Cargo_Padronizado =
			
			VAR c = UPPER(TRIM(COALESCE([Cargo], "")))
			RETURN
			    SWITCH(
			        TRUE(),
			        c = "TECNICO",                    "Técnico",
			        c = "LIDER" || c = "LÍDER",       "Líder",
			        c = "COORDENADOR",                "Coordenador",
			        c = "ASSISTENTE",                 "Assistente",
			        c = "MATRIZ" || c = "ADMIN",      "Matriz",
			        [Cargo]
			    )
		lineageTag: b4c565ec-cd68-490d-9397-6d5bf576bc83
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Nome (Exibição)' =
			
			VAR nn = Eixo_Colaboradores[Nome_Normalizado]
			VAR t = TRIM ( COALESCE ( nn, "" ) )
			RETURN
			IF (
			    LEFT ( t, 4 ) = "MAT-",
			    "—",
			    nn
			)
		lineageTag: 467a79e3-614e-4833-a858-d3d8ef2229e1
		summarizeBy: none

