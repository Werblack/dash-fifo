table Eixo_Colaboradores
	lineageTag: ff9d588f-3391-4cdf-a0ff-b5e0a23d2d5f

	measure 'SLA_% (Tabela)' =
			
			VAR CargoCtx = SELECTEDVALUE(Eixo_Colaboradores[Cargo_Padronizado])
			VAR MatCtx = SELECTEDVALUE(Eixo_Colaboradores[Matricula])
			VAR NomeCtx = SELECTEDVALUE(Eixo_Colaboradores[Nome])
			VAR PoloRegra = SELECTEDVALUE(Eixo_Colaboradores[Polo Base (Regra)])
			VAR PoloReal = SELECTEDVALUE(Eixo_Colaboradores[Polo_Base])
			VAR EhMatriz = SELECTEDVALUE(Eixo_Colaboradores[IsMatriz])
			RETURN
			    SWITCH(
			        TRUE(),
			        CargoCtx = "Técnico",
			            CALCULATE(
			                DIVIDE(SUM(FactOS[SLA_Dentro_Prazo]), COUNTROWS(FactOS)),
			                FactOS[Matricula] = MatCtx
			            ),
			        CargoCtx = "Assistente",
			            VAR _polo = IF(EhMatriz && PoloRegra = "Matriz", PoloReal, PoloRegra)
			            RETURN
			                CALCULATE(
			                    DIVIDE(SUM(FactOS[SLA_Dentro_Prazo]), COUNTROWS(FactOS)),
			                    REMOVEFILTERS(FactOS),
			                    FactOS[des_service_provider] = _polo
			                ),
			        CargoCtx = "Líder",
			            CALCULATE(
			                DIVIDE(SUM(FactOS[SLA_Dentro_Prazo]), COUNTROWS(FactOS)),
			                REMOVEFILTERS(FactOS),
			                UPPER(TRIM(FactOS[Líder])) = UPPER(TRIM(NomeCtx))
			            ),
			        CargoCtx = "Coordenador",
			            CALCULATE(
			                DIVIDE(SUM(FactOS[SLA_Dentro_Prazo]), COUNTROWS(FactOS)),
			                REMOVEFILTERS(FactOS),
			                UPPER(TRIM(FactOS[Coordenador.Coordenador])) = UPPER(TRIM(NomeCtx))
			            )
			    )
		lineageTag: 48671607-546c-4ba8-9563-177457870a2b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Ativacao_% (Tabela)' =
			
			VAR CargoCtx   = SELECTEDVALUE(Eixo_Colaboradores[Cargo_Padronizado])
			VAR MatCtx     = SELECTEDVALUE(Eixo_Colaboradores[Matricula])
			VAR NomeCtx    = SELECTEDVALUE(Eixo_Colaboradores[Nome])
			VAR PoloRegra  = SELECTEDVALUE(Eixo_Colaboradores[Polo Base (Regra)])
			VAR PoloReal   = SELECTEDVALUE(Eixo_Colaboradores[Polo_Base])
			VAR EhMatriz   = SELECTEDVALUE(Eixo_Colaboradores[IsMatriz])
			
			VAR _filtro_motivo =
			    FILTER(
			        ALL(FactOS[motivo_saida]),
			        LOWER(TRIM(FactOS[motivo_saida])) IN {
			            "adesão",
			            "atendimento expresso",
			            "instalação comodato"
			        }
			    )
			
			RETURN
			    SWITCH(
			        TRUE(),
			        CargoCtx = "Técnico",
			            CALCULATE(
			                DIVIDE(SUM(FactOS[Ativacao_Flag]), COUNTROWS(FactOS)),
			                FactOS[Matricula] = MatCtx,
			                _filtro_motivo
			            ),
			        CargoCtx = "Assistente",
			            VAR _polo = IF(EhMatriz && PoloRegra = "Matriz", PoloReal, PoloRegra)
			            RETURN
			                CALCULATE(
			                    DIVIDE(SUM(FactOS[Ativacao_Flag]), COUNTROWS(FactOS)),
			                    REMOVEFILTERS(FactOS),
			                    FactOS[des_service_provider] = _polo,
			                    _filtro_motivo
			                ),
			        CargoCtx = "Líder",
			            CALCULATE(
			                DIVIDE(SUM(FactOS[Ativacao_Flag]), COUNTROWS(FactOS)),
			                REMOVEFILTERS(FactOS),
			                UPPER(TRIM(FactOS[Líder])) = UPPER(TRIM(NomeCtx)),
			                _filtro_motivo
			            ),
			        CargoCtx = "Coordenador",
			            CALCULATE(
			                DIVIDE(SUM(FactOS[Ativacao_Flag]), COUNTROWS(FactOS)),
			                REMOVEFILTERS(FactOS),
			                UPPER(TRIM(FactOS[Coordenador.Coordenador])) = UPPER(TRIM(NomeCtx)),
			                _filtro_motivo
			            )
			    )
		lineageTag: eec91579-4037-46fb-9f73-d926cafb7296

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'CSAT Médio (Tabela)' =
			
			VAR CargoCtx = SELECTEDVALUE(Eixo_Colaboradores[Cargo_Padronizado])
			VAR MatCtx = SELECTEDVALUE(Eixo_Colaboradores[Matricula])
			VAR NomeCtx = SELECTEDVALUE(Eixo_Colaboradores[Nome])
			VAR PoloRegra = SELECTEDVALUE(Eixo_Colaboradores[Polo Base (Regra)])
			VAR PoloReal = SELECTEDVALUE(Eixo_Colaboradores[Polo_Base])
			VAR EhMatriz = SELECTEDVALUE(Eixo_Colaboradores[IsMatriz])
			RETURN
			    SWITCH(
			        TRUE(),
			        CargoCtx = "Técnico",
			            CALCULATE(
			                AVERAGE(FactCSAT[nota_pesquisa]),
			                FactCSAT[Matricula2] = MatCtx
			            ),
			        CargoCtx = "Assistente",
			            VAR _polo = IF(EhMatriz && PoloRegra = "Matriz", PoloReal, PoloRegra)
			            RETURN
			                CALCULATE(
			                    AVERAGE(FactCSAT[nota_pesquisa]),
			                    REMOVEFILTERS(FactCSAT),
			                    FactCSAT[des_service_provider] = _polo
			                ),
			        CargoCtx = "Líder",
			            CALCULATE(
			                AVERAGE(FactCSAT[nota_pesquisa]),
			                REMOVEFILTERS(FactCSAT),
			                UPPER(TRIM(FactCSAT[Líder])) = UPPER(TRIM(NomeCtx))
			            ),
			        CargoCtx = "Coordenador",
			            CALCULATE(
			                AVERAGE(FactCSAT[nota_pesquisa]),
			                REMOVEFILTERS(FactCSAT),
			                UPPER(TRIM(FactCSAT[Coordenador])) = UPPER(TRIM(NomeCtx))
			            )
			    )
		lineageTag: a8655498-fade-4733-9eae-e90fb13c3bdc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

