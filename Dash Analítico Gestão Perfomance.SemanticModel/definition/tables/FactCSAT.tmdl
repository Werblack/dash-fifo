	measure '_Tec Polos from 03' =
			
			VAR MatSel = SELECTEDVALUE(Eixo_Colaboradores[Matricula])
			RETURN
			CALCULATETABLE(
			    DISTINCT(FactOS[des_service_provider]),
			    TREATAS( { MatSel }, FactOS[Matricula] )
			)
