	column KeyHierarquia =
			
			VAR Coord = COALESCE( TRIM( FactCSAT[Coordenador] ), "" )   // ajuste o nome se for outro
			VAR Lider = COALESCE( TRIM( FactCSAT[Líder] ), "" )
			VAR Polo  = COALESCE( TRIM( FactCSAT[des_service_provider] ), "" )
			RETURN Coord & "|" & Lider & "|" & Polo
		lineageTag: 00ed60d2-2571-4546-bad4-94a0dd284177
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

