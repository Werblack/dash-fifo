table 'Semanal FIFO'
	excludeFromModelRefresh
	lineageTag: 896e5b50-99aa-403c-a1c5-916e33ded316

	measure Total_Estoque = ```
			
			     COUNTROWS ( 'Semanal FIFO' )
			```
		formatString: 0
		lineageTag: 1cfbf05e-68ad-4965-88cb-4c6f6fa491a1

	measure Estoque_Cluster_120 =
			
			CALCULATE (
			    [Total_Estoque],
			    KEEPFILTERS (
			        FILTER (
			            'Semanal FIFO',
			            UPPER ( TRIM ( 'Semanal FIFO'[Cluster] ) ) = "MAIS DE 120D"
			        )
			    )
			)
		formatString: 0
		lineageTag: 00e445f2-a6ec-4a2f-a459-70624070254d

	measure Pct_Estoque_120 =
			
			DIVIDE ( [Estoque_Cluster_120], [Total_Estoque] )
		lineageTag: 14978fbe-a4fb-4217-ad9f-65da84e1c600

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Estoque_Polo_Aging30 =
			
			CALCULATE (
			    [Total_Estoque],
			    KEEPFILTERS (
			        FILTER (
			            'Semanal FIFO',
			            UPPER ( TRIM ( 'Semanal FIFO'[Cluster] ) ) IN { "31 A 120D", "MAIS DE 120D" }
			        )
			    )
			)
		formatString: 0
		lineageTag: 4e1cbfbc-c607-4898-bda8-b6e3076b7b55

	measure Total_Estoque_Familia =
			
			CALCULATE ( [Total_Estoque], VALUES ( Modelo[Família de Produtos] ) )
		formatString: 0
		lineageTag: 23aae801-bdf2-42dd-90bc-f8f590279a49

	measure Modelo_Maior_Quantidade =
			
			VAR TabelaModelos =
			    FILTER(
			        SUMMARIZECOLUMNS(
			            Modelo[Código],
			            "NomeModelo", MAX(Modelo[Nome]),
			            "Quantidade", [Total_Estoque]
			        ),
			        [Quantidade] > 0
			    )
			VAR TopLinha =
			    TOPN(
			        1,
			        TabelaModelos,
			        [Quantidade],
			        DESC,
			        [NomeModelo]
			    )
			RETURN
			    COALESCE(
			        MAXX(TopLinha, [NomeModelo]),
			        "—"
			    )
		lineageTag: bd776e77-a0b6-453c-9ae9-e26f18fb9500

	measure Quantidade_Modelo_Top =
			
			VAR TabelaModelos =
			    FILTER(
			        SUMMARIZECOLUMNS(
			            Modelo[Código],
			            "NomeModelo", MAX(Modelo[Nome]),
			            "Quantidade", [Total_Estoque]
			        ),
			        [Quantidade] > 0
			    )
			VAR TopLinha =
			    TOPN(
			        1,
			        TabelaModelos,
			        [Quantidade],
			        DESC,
			        [NomeModelo]
			    )
			RETURN
			    COALESCE(
			        MAXX(TopLinha, [Quantidade]),
			        0
			    )
		formatString: 0
		lineageTag: e7cbba00-44ec-46da-9fe5-35897aecfa04

	measure Data_Ultima_Semana =
			
			CALCULATE (
			    MAX ( 'Semanal FIFO'[DataReferencia] ),
			    ALL ( 'Semanal FIFO' )
			)
		formatString: General Date
		lineageTag: 2dba9dcc-bf7e-4019-a11d-2d52dcf22d8f

	measure Data_Semana_Anterior =
			
			CALCULATE (
			    MAX ( 'Semanal FIFO'[DataReferencia] ),
			    FILTER (
			        ALL ( 'Semanal FIFO' ),
			        'Semanal FIFO'[DataReferencia] < [Data_Ultima_Semana]
			    )
			)
		formatString: General Date
		lineageTag: e3086b7f-438b-4db1-badf-f64d01a4f583

	measure Arquivo_Snapshot_Atual =
			
			VAR MaxIndice =
			    CALCULATE ( MAX ( 'Semanal FIFO'[ArquivoIndice] ), ALL ( 'Semanal FIFO' ) )
			RETURN
			    CALCULATE (
			        MAX ( 'Semanal FIFO'[Arquivo_Origem] ),
			        FILTER ( ALL ( 'Semanal FIFO' ), 'Semanal FIFO'[ArquivoIndice] = MaxIndice )
			    )
		lineageTag: b9958c80-fff3-41a4-bdb4-14244eea1a3b

	measure Arquivo_Snapshot_Anterior =
			
			VAR MaxIndice =
			    CALCULATE ( MAX ( 'Semanal FIFO'[ArquivoIndice] ), ALL ( 'Semanal FIFO' ) )
			VAR IndiceAnterior =
			    CALCULATE (
			        MAX ( 'Semanal FIFO'[ArquivoIndice] ),
			        FILTER ( ALL ( 'Semanal FIFO' ), 'Semanal FIFO'[ArquivoIndice] < MaxIndice )
			    )
			RETURN
			    CALCULATE (
			        MAX ( 'Semanal FIFO'[Arquivo_Origem] ),
			        FILTER ( ALL ( 'Semanal FIFO' ), 'Semanal FIFO'[ArquivoIndice] = IndiceAnterior )
			    )
		lineageTag: 9de7e321-a351-43ff-aaf3-1cc2e751fcc3

	measure Estoque_Snapshot_Atual =
			
			VAR MaxIndice =
			    CALCULATE ( MAX ( 'Semanal FIFO'[ArquivoIndice] ), ALL ( 'Semanal FIFO' ) )
			RETURN
			    CALCULATE (
			        [Total_Estoque],
			        FILTER ( ALL ( 'Semanal FIFO' ), 'Semanal FIFO'[ArquivoIndice] = MaxIndice )
			    )
		formatString: 0
		lineageTag: a8fb9178-7268-4bcc-bd04-a349b77b80bb

	measure Estoque_Snapshot_Anterior =
			
			VAR MaxIndice =
			    CALCULATE ( MAX ( 'Semanal FIFO'[ArquivoIndice] ), ALL ( 'Semanal FIFO' ) )
			VAR IndiceAnterior =
			    CALCULATE (
			        MAX ( 'Semanal FIFO'[ArquivoIndice] ),
			        FILTER ( ALL ( 'Semanal FIFO' ), 'Semanal FIFO'[ArquivoIndice] < MaxIndice )
			    )
			RETURN
			    CALCULATE (
			        [Total_Estoque],
			        FILTER ( ALL ( 'Semanal FIFO' ), 'Semanal FIFO'[ArquivoIndice] = IndiceAnterior )
			    )
		formatString: 0
		lineageTag: 33a0f7d4-3571-463d-9bd0-d221d8cb7335

	measure Diferenca_Semanal =
			
			[Estoque_Snapshot_Atual] - [Estoque_Snapshot_Anterior]
		formatString: 0
		lineageTag: 9d3b7507-a7e9-48ed-8821-68eecb3ccb01

	measure Diferenca_Semanal_% =
			
			DIVIDE ( [Diferenca_Semanal], [Estoque_Snapshot_Anterior] )
		formatString: "+0,0%;-0,0%;0,0% "
		lineageTag: 1798c461-911b-442d-89ff-65e153420dd9

		annotation PBI_FormatHint = {"isCustom":true}

