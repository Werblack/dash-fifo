	partition 'Semanal FIFO' = m
		mode: import
		source =
				let
				    PastaSAP = "C:\Users\sbahia\OneDrive - UNIVERSO ONLINE S.A\Área de Trabalho\Ambiente PY\logins\Dash Fifo\Semanal FIFO",
				
				    Fonte =
				        Folder.Files(PastaSAP),
				
				    #"Arquivos Visiveis" =
				        Table.SelectRows(
				            Fonte,
				            each [Attributes]?[Hidden]? <> true
				        ),
				
				    #"Arquivos Filtrados" =
				        Table.SelectRows(
				            #"Arquivos Visiveis",
				            each Text.Contains(Text.Lower([Name]), "estoque_sap")
				        ),
				
				    #"Colunas Selecionadas" =
				        Table.SelectColumns(
				            #"Arquivos Filtrados",
				            {"Content","Name","Date created","Date modified"}
				        ),
				
				    LimpaTexto = (valor as any) as nullable text =>
				        if valor = null then
				            null
				        else if Value.Is(valor, type text) then
				            Text.Trim(valor)
				        else
				            Text.Trim(Text.From(valor, "pt-BR")),
				
				    ConverteData = (valor as any) as nullable datetime =>
				        if valor = null then
				            null
				        else if Value.Is(valor, type datetime) then
				            valor
				        else if Value.Is(valor, type date) then
				            DateTime.From(valor)
				        else if Value.Is(valor, type text) and Text.Trim(valor) = "" then
				            null
				        else
				            DateTime.FromText(Text.From(valor, "pt-BR"), "pt-BR"),
				
				    #"Tabela Transformada" =
				        Table.AddColumn(
				            #"Colunas Selecionadas",
				            "Tabela",
				            each
				                let
				                    ObjetoExcel  = Excel.Workbook([Content], null, true),
				                    PlanilhaBase = Table.SelectRows(ObjetoExcel, each [Kind] = "Sheet" and [Name] = "Base"){0}[Data],
				                    Cabecalho    = Table.PromoteHeaders(PlanilhaBase, [PromoteAllScalars = true]),
				                    CabecTrim    = Table.TransformColumnNames(Cabecalho, Text.Trim),
				                    LinhasOk     = Table.SelectRows(CabecTrim, each List.NonNullCount(Record.FieldValues(_)) > 0)
				                in
				                    LinhasOk
				        ),
				
				    #"SomenteTabela" =
				        Table.SelectColumns(
				            #"Tabela Transformada",
				            {"Name","Date created","Date modified","Tabela"}
				        ),
				
				    #"Tabela Expandida" =
				        Table.ExpandTableColumn(
				            #"SomenteTabela",
				            "Tabela",
				            {
				                "Material","Descrição Material","Nº de Série","Status Sistema",
				                "Fornecedor","Cliente","Centro","Depósito","Criado por","Dt.Criação",
				                "Modificado em","Modificado por","POLO","FAMILIA","MÊS","ANO","Cluster"
				            },
				            {
				                "Material","Descrição Material","Nº de Série","Status Sistema",
				                "Fornecedor","Cliente","Centro","Depósito","Criado por","Dt.Criação",
				                "Modificado em","Modificado por","POLO","FAMILIA","MÊS","ANO","Cluster"
				            }
				        ),
				
				    #"Campos Textuais Normalizados" =
				        Table.TransformColumns(
				            #"Tabela Expandida",
				            {
				                {"Material", LimpaTexto, type text},
				                {"Descrição Material", LimpaTexto, type text},
				                {"Nº de Série", LimpaTexto, type text},
				                {"Status Sistema", LimpaTexto, type text},
				                {"Fornecedor", LimpaTexto, type text},
				                {"Cliente", LimpaTexto, type text},
				                {"Centro", LimpaTexto, type text},
				                {"Depósito", LimpaTexto, type text},
				                {"Criado por", LimpaTexto, type text},
				                {"Modificado por", LimpaTexto, type text},
				                {"POLO", LimpaTexto, type text},
				                {"FAMILIA", LimpaTexto, type text},
				                {"MÊS", LimpaTexto, type text},
				                {"Cluster", LimpaTexto, type text}
				            }
				        ),
				
				    #"Datas Convertidas" =
				        Table.TransformColumns(
				            #"Campos Textuais Normalizados",
				            {
				                {"Dt.Criação", ConverteData, type datetime},
				                {"Modificado em", ConverteData, type datetime}
				            }
				        ),
				
				    #"Tipos Ajustados" =
				        Table.TransformColumnTypes(
				            #"Datas Convertidas",
				            {{"ANO", Int64.Type}},
				            "pt-BR"
				        ),
				
				    #"Linhas Úteis" =
				        Table.SelectRows(
				            #"Tipos Ajustados",
				            each not List.IsEmpty(List.RemoveNulls({[Material]}))
				        ),
				
				    #"Data Referencia" =
				        Table.AddColumn(
				            #"Linhas Úteis",
				            "DataReferencia",
				            each
				                let
				                    dataMod = [Modificado em],
				                    dataCri = [Dt.Criação]
				                in
				                    if dataMod <> null then
				                        Date.From(dataMod)
				                    else if dataCri <> null then
				                        Date.From(dataCri)
				                    else
				                        null,
				            type date
				        ),
				
				    #"AnoMes" =
				        Table.AddColumn(
				            #"Data Referencia",
				            "AnoMes",
				            each
				                if [DataReferencia] = null then
				                    null
				                else
				                    Text.Combine(
				                        {
				                            Text.From(Date.Year([DataReferencia])),
				                            Text.PadStart(Text.From(Date.Month([DataReferencia])), 2, "0")
				                        },
				                        "-"
				                    ),
				            type text
				        ),
				
				    #"Dias em Estoque" =
				        Table.AddColumn(
				            #"AnoMes",
				            "Dias_Estoque",
				            each
				                if [Dt.Criação] = null then
				                    null
				                else
				                    Duration.Days(Date.From(DateTime.LocalNow()) - Date.From([Dt.Criação])),
				            Int64.Type
				        ),
				
				    #"Metadados em DataTime" =
				        Table.TransformColumns(
				            #"Dias em Estoque",
				            {
				                {"Date created", each DateTime.From(_), type datetime},
				                {"Date modified", each DateTime.From(_), type datetime}
				            }
				        ),
				
				    #"Colunas Renomeadas" =
				        Table.RenameColumns(
				            #"Metadados em DataTime",
				            {
				                {"Name","Arquivo_Origem"},
				                {"Date created","DataArquivo"},
				                {"Date modified","DataModificacao"}
				            }
				        ),
				
				    // <<< NOVA ETAPA >>>
				    #"Coluna ArquivoIndice" =
				        Table.AddColumn(
				            #"Colunas Renomeadas",
				            "ArquivoIndice",
				            each
				                let
				                    numeros = Text.Select([Arquivo_Origem], {"0".."9"})
				                in
				                    try Number.From(numeros) otherwise null,
				            Int64.Type
				        ),
				
				    #"Colunas Reordenadas" =
				        Table.ReorderColumns(
				            #"Coluna ArquivoIndice",
				            {
				                "Arquivo_Origem","ArquivoIndice","DataArquivo","DataModificacao",
				                "Material","Descrição Material","Nº de Série","Status Sistema",
				                "Fornecedor","Cliente","Centro","Depósito","Criado por","Dt.Criação",
				                "Modificado em","Modificado por","POLO","FAMILIA","MÊS","ANO",
				                "AnoMes","DataReferencia","Dias_Estoque","Cluster"
				            }
				        )
				in
				    #"Colunas Reordenadas"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegação

