	measure Total_OS_SLA_Base =
			
			VAR TabelaSLA =
			    FILTER(
			        Consolidado_Abono,
			        NOT ISBLANK ( Consolidado_Abono[Data_SLA] )
			    )
			RETURN
			CALCULATE(
			    DISTINCTCOUNT ( Consolidado_Abono[OS_ID] ),
			    TabelaSLA
			)
		formatString: 0
		lineageTag: 71c3a1fa-054d-41c3-b784-6333f0b9329a

	measure Qtd_OS_Justificado =
			
			VAR OS_VisiveisComCondicao =
			    FILTER (
			        VALUES ( Consolidado_Abono[OS_ID] ),
			        CALCULATE (
			            COUNTROWS (
			                FILTER (
			                    Consolidado_Abono,
			                        Consolidado_Abono[Data_SLA] <> BLANK ()
			                    &&  UPPER ( TRIM ( Consolidado_Abono[Está no Prazo?] ) ) = "FORA DO PRAZO"
			                    &&  Consolidado_Abono[Fonte] = "Workfinity"
			                    &&  NOT ISBLANK ( Consolidado_Abono[Status da Justificativa] )
			                    &&  TRIM ( Consolidado_Abono[Status da Justificativa] ) <> "Aguardando Justificativa"
			                )
			            )
			        ) > 0
			    )
			RETURN
			COUNTROWS ( OS_VisiveisComCondicao )
		formatString: 0
		lineageTag: 43fc2f03-e4ce-450a-a7d6-60ee53efeb5c

	measure Data_Ultima_Atualizacao_BI =
			
			FORMAT(
			    MAX ( UltimaAtualizacao[DataHoraAtualizacao] ),
