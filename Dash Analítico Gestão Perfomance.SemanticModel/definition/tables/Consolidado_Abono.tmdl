	partition Consolidado_Abono = m
		mode: import
		source =
				let
				    Base =
				        Table.Combine({
				            Consolidado_Abono_HISTORICO,
				            Consolidado_Abono_ATUAL
				        }),
				
				    JoinRevisita =
				        Table.NestedJoin(
				            Base,
				            {"OS_ID"},
				            Revisita_Consolidado,
				            {"OS_ID"},
				            "Rev",
				            JoinKind.LeftOuter
				        ),
				
				    ExpRevisita =
				        Table.ExpandTableColumn(
				            JoinRevisita,
				            "Rev",
				            {"2ª Visita foi no Prazo?"},
				            {"Revisita"}
				        ),
				
				    Status_Abono_Atualizado =
				        Table.AddColumn(
				            ExpRevisita,
				            "__Status_Abono_Novo",
				            each
				                let
				                    revSim = [Revisita] = "Sim",
				                    fonteSomenteBI = [Fonte] = "Somente BI",
				                    motivoRevisita =
				                        Text.Trim([#"Justificativa do Prestador"]) = "Outros | Revisita"
				                in
				                    if revSim and (fonteSomenteBI or motivoRevisita)
				                    then "Abonada"
				                    else [Status_Abono],
				            type text
				        ),
				
				    RemoveStatusAntigo =
				        Table.RemoveColumns(Status_Abono_Atualizado, {"Status_Abono"}),
				
				    RenomeiaStatus =
				        Table.RenameColumns(
				            RemoveStatusAntigo,
				            {{"__Status_Abono_Novo", "Status_Abono"}}
				        )
				in
				    RenomeiaStatus

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

