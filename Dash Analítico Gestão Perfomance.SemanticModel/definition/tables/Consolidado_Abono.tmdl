	column Categoria_Abono =
			
			IF(
			    Consolidado_Abono[Está no Prazo?] = "Dentro do prazo",
			    BLANK(),
			    SWITCH(
			        TRUE(),
			        Consolidado_Abono[WF_Abono] = "Abonada", "Abonada",
			        Consolidado_Abono[WF_Abono] = "Não Abonada", "Não Abonada",
			        ISBLANK(Consolidado_Abono[WF_Abono]) || Consolidado_Abono[WF_Abono] = "", "Pendente de Abono",
			        "Pendente de Abono"
			    )
			)
		lineageTag: 22dd4bee-8fea-4693-8117-64d6e9501dec
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

