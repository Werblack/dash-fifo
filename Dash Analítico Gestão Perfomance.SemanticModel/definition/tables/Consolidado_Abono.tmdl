	measure Total_Abonadas_FP =
			
			CALCULATE(
			    COUNTROWS(Consolidado_Abono),
			    Consolidado_Abono[Está no Prazo?] = "Fora do prazo",
			    NOT ISBLANK(Consolidado_Abono[WF_Abono])
			)
		formatString: 0
		lineageTag: 012c898a-8628-4824-acc6-8c9082ab04e7

	measure OS_Pendente_Abono =
			
			CALCULATE(
			    COUNTROWS(Consolidado_Abono),
			    Consolidado_Abono[Está no Prazo?] = "Fora do prazo",
			    Consolidado_Abono[Status da Justificativa] = "Aguardando Justificativa"
			)
		formatString: 0
		lineageTag: 99bfffed-7756-4150-8fb7-4e3ad8991b9c

	measure Validacao =
			[OS_Somente_BI] + [OS_Pendente_Abono] + [Total_Abonadas_FP]
			// Deve ser igual a [Total_OS_FP]
		formatString: 0
		lineageTag: a90ec3cb-7e21-4c09-b9f0-ef8b034503ab

	measure Teste_Aguardando =
			
			CALCULATE(
			    COUNTROWS(Consolidado_Abono),
			    Consolidado_Abono[Está no Prazo?] = "Fora do prazo",
			    Consolidado_Abono[Status da Justificativa] = "Aguardando Justificativa"
			)
		formatString: 0
		lineageTag: eac97770-edff-49f5-9b61-59f72769dc84

	measure OS_Processadas =
			
			CALCULATE(
			    COUNTROWS(Consolidado_Abono),
			    Consolidado_Abono[Está no Prazo?] = "Fora do prazo",
			    Consolidado_Abono[Status da Justificativa] <> "Aguardando Justificativa",
			    NOT ISBLANK(Consolidado_Abono[Status da Justificativa])
			)
		formatString: 0
		lineageTag: ba7719b7-a362-4ead-8f8c-87debf496892

	measure Pendente_Justificativa =
			
			VAR OS_VisiveisComCondicao =
			    FILTER (
			        VALUES ( Consolidado_Abono[OS_ID] ),   -- só os OS_ID visíveis no contexto (matriz/tabela)
			        CALCULATE (
			            COUNTROWS (
			                FILTER (
			                    Consolidado_Abono,
			                        Consolidado_Abono[Data_SLA] <> BLANK ()
			                    &&  UPPER ( TRIM ( Consolidado_Abono[Está no Prazo?] ) ) = "FORA DO PRAZO"
			                    &&  Consolidado_Abono[Fonte] = "Workfinity"
			                    &&  TRIM ( Consolidado_Abono[Status da Justificativa] ) = "Aguardando Justificativa"
			                )
			            )
			        ) > 0
			    )
			RETURN
			COUNTROWS ( OS_VisiveisComCondicao )
		formatString: 0
		lineageTag: 8083040a-2f1c-4a91-98f2-4303397522f2

	measure Just_Mais_Comum = ```
			
			VAR TabelaJustificativas = 
			    ADDCOLUMNS(
			        FILTER(
			            VALUES(Consolidado_Abono[WF_Just_Prest]),
			            NOT ISBLANK(Consolidado_Abono[WF_Just_Prest]) &&
			            Consolidado_Abono[WF_Just_Prest] <> ""
			        ),
			        "Quantidade", CALCULATE(COUNTROWS(Consolidado_Abono))
			    )
			VAR MaxQuantidade = 
			    MAXX(TabelaJustificativas, [Quantidade])
			VAR JustificativaTop = 
			    MAXX(
			        FILTER(TabelaJustificativas, [Quantidade] = MaxQuantidade),
			        Consolidado_Abono[WF_Just_Prest]
			    )
			RETURN
			    JustificativaTop
			```
		lineageTag: f0de6cef-1f5b-4cc3-92e6-a072328f9695

	measure Qtd_Just_Mais_Comum =
			
			VAR JustificativaTop = [Just_Mais_Comum]
			RETURN
			    CALCULATE(
			        COUNTROWS(Consolidado_Abono),
			        Consolidado_Abono[WF_Just_Prest] = JustificativaTop
			    )
		formatString: 0
		lineageTag: 913b7ac1-b98e-4ece-adff-eaaf0d0d6fb2

	measure Perc_Just_Mais_Comum = ```
			
			VAR TotalComJustificativa = 
			    CALCULATE(
			        COUNTROWS(Consolidado_Abono),
			        NOT ISBLANK(Consolidado_Abono[WF_Just_Prest]),
			        Consolidado_Abono[WF_Just_Prest] <> ""
			    )
			RETURN
			    DIVIDE(
			        [Qtd_Just_Mais_Comum],
			        TotalComJustificativa,
			        0
			    )
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 7ec30402-7dde-45e8-aabc-81a38f3dcd1b

	measure Total_Pendente_Abono =
			
			CALCULATE(
			    COUNTROWS(Consolidado_Abono),
			    Consolidado_Abono[Está no Prazo?] <> "Dentro do prazo",
			    OR(
			        ISBLANK(Consolidado_Abono[WF_Abono]),
			        Consolidado_Abono[WF_Abono] = ""
			    )
			)
		formatString: 0
		lineageTag: cd8a618e-5a22-45f7-80d9-01bef2a5fa56

	measure Abonos_Pendentes =
			
			VAR TabelaPendAbono =
			    FILTER (
			        Consolidado_Abono,
			            NOT ISBLANK ( Consolidado_Abono[Data_SLA] )
			        &&  UPPER ( TRIM ( Consolidado_Abono[Está no Prazo?] ) ) = "FORA DO PRAZO"
			        &&  NOT ISBLANK ( Consolidado_Abono[Status da Justificativa] )
			        &&  Consolidado_Abono[Status da Justificativa] <> "Aguardando Justificativa"
			        &&  (
			                ISBLANK ( Consolidado_Abono[WF_Abono] )
			             || NOT (
			                    UPPER ( TRIM ( Consolidado_Abono[WF_Abono] ) )
			                        IN { "ABONADA", "NAO ABONADA", "NÃO ABONADA" }
			                )
			            )
			    )
			RETURN
			CALCULATE (
			    DISTINCTCOUNT ( Consolidado_Abono[OS_ID] ),
			    TabelaPendAbono
			)
		formatString: 0
		lineageTag: 0117148e-380f-47ae-a623-222bbf8f0e67

	measure 'SLA Dif' =
			
			[SLA_Com_Abono] - [SLA_Sem_Abono]
		formatString: +0,00%;-0,00%;0,00%
		lineageTag: 7b8d938e-2c9a-4a70-acb9-de1c938908b4

		annotation PBI_FormatHint = {"isCustom":true}

	measure SLA_Resumo_Abono =
			
			VAR slaCom = [SLA_Com_Abono]
			VAR slaSem = [SLA_Sem_Abono]
			VAR dif    = [SLA Dif]
			RETURN
			    "SLA com abono: " & FORMAT(slaCom, "0,00%") &
			    UNICHAR(10) &
			    "SLA sem abono: " & FORMAT(slaSem, "0,00%") &
			    UNICHAR(10) &
			    "Diferença: " & FORMAT(dif, "+0,00%;-0,00%;0,00%")
		lineageTag: e1d3df7f-76e6-4540-9b8b-1da74bf2083e

