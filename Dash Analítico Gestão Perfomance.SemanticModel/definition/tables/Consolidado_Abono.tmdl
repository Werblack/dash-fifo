table Consolidado_Abono
	lineageTag: 497c4b41-90d3-433e-94b2-215fe189dfbe

	measure Total_OS_FP =
			
			VAR TabelaFechadaForaPrazo =
			    FILTER (
			        Consolidado_Abono,
			            NOT ISBLANK ( Consolidado_Abono[Data_SLA] )
			        &&  UPPER ( TRIM ( Consolidado_Abono[Está no Prazo?] ) ) = "FORA DO PRAZO"
			    )
			RETURN
			CALCULATE (
			    DISTINCTCOUNT ( Consolidado_Abono[OS_ID] ),
			    TabelaFechadaForaPrazo
			)
		formatString: 0
		lineageTag: 43d2c5d2-de59-4444-89ed-8867f4e6219f

	measure WF_Pendentes =
			
			CALCULATE(
			    COUNTROWS(Consolidado_Abono),
			    Consolidado_Abono[Fonte] = "Workfinity",
			    Consolidado_Abono[Status da Justificativa] = "Aguardando Justificativa",
			    ISBLANK(Consolidado_Abono[WF_Abono])
			)
		formatString: 0
		lineageTag: 79004fbc-0f98-4997-bbc1-685c1186e0dd

	measure Total_Abonadas =
			
			CALCULATE(
			    COUNTROWS(Consolidado_Abono),
			    Consolidado_Abono[WF_Abono] = "Abonada"
			)
		formatString: 0
		lineageTag: d7448c17-89ed-43c9-823d-d57512c9d4d3

	measure Total_Nao_Abonadas =
			
			CALCULATE(
			    COUNTROWS(Consolidado_Abono),
			    Consolidado_Abono[WF_Abono] = "Não Abonada"
			)
		formatString: 0
		lineageTag: e35bc1bb-e93d-485e-bef5-dc9c3d9b04c4

	measure OS_no_Workfinity =
			
			CALCULATE(
			    COUNTROWS(Consolidado_Abono),
			    Consolidado_Abono[Está no Prazo?] = "Fora do prazo",
			    NOT ISBLANK(Consolidado_Abono[Status da Justificativa])
			)
		formatString: 0
		lineageTag: fb696160-586a-492a-92c6-857b310f0337

	measure WF_Atrasadas = ```
			
			CALCULATE(
			    COUNTROWS(Consolidado_Abono),
			    Consolidado_Abono[Fonte] = "Workfinity",
			    Consolidado_Abono[Status da Justificativa] = "Aguardando Justificativa",
			    Consolidado_Abono[Data Limite Atendimento] < TODAY()
			)
			
			```
		formatString: 0
		lineageTag: f6a71060-7e2c-475f-a368-226481faf5fc

	measure OS_Somente_BI =
			
			CALCULATE(
			    COUNTROWS(Consolidado_Abono),
			    Consolidado_Abono[Está no Prazo?] = "Fora do prazo",
