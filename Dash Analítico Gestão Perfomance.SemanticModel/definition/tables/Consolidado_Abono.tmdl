		formatString: 0
		lineageTag: 271673b2-88ee-4343-95c6-4f7b2838fd2a

	measure OS_Dentro_Prazo = ```
			
			CALCULATE(
			    COUNTROWS(Consolidado_Abono),
			    Consolidado_Abono[Está no Prazo?] = "Dentro do prazo"
			)
			
			```
		formatString: 0
		lineageTag: 607a494c-476b-4fde-b3d3-0fcadb7cb190

	measure OS_Fechadas_Fora_Prazo =
			
			CALCULATE (
			    DISTINCTCOUNT ( Consolidado_Abono[OS_ID] ),
			    KEEPFILTERS (
			        UPPER ( TRIM ( Consolidado_Abono[Está no Prazo?] ) ) = "FORA DO PRAZO"
			    )
			)
		formatString: 0
		lineageTag: c44eb6ed-4e2a-4bbc-a3a3-df72424072f1

		annotation PBI_FormatHint = {"isDecimal":true}

	measure Total_OS = COUNTROWS(Consolidado_Abono)
		formatString: 0
		lineageTag: c9d6cc35-bba3-496f-91b4-4be1e204168d

	measure SLA_Sem_Abono = ```
			
			VAR OSDentroPrazo = 
			    CALCULATE(
			        COUNTROWS(Consolidado_Abono),
			        Consolidado_Abono[Está no Prazo?] = "Dentro do prazo"
			    )
			VAR TotalOS = 
			    COUNTROWS(Consolidado_Abono)
			RETURN
			    DIVIDE(OSDentroPrazo, TotalOS, 0)
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 934e3f27-17cd-4ee5-8726-af65b3d26c56

	measure SLA_Com_Abono = ```
			
			VAR OSDentroPrazo = 
			    CALCULATE(
			        COUNTROWS(Consolidado_Abono),
			        Consolidado_Abono[Está no Prazo?] = "Dentro do prazo"
			    )
			VAR OSAbonadas = 
			    CALCULATE(
			        COUNTROWS(Consolidado_Abono),
			        Consolidado_Abono[WF_Abono] = "Abonada"
			    )
			VAR TotalOS = 
			    COUNTROWS(Consolidado_Abono)
			RETURN
			    DIVIDE(OSDentroPrazo + OSAbonadas, TotalOS, 0)
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 3f804412-296e-4697-b8ab-ac23f6c6efe3

