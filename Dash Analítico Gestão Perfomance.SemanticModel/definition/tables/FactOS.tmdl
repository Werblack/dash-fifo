	measure 'CSAT Médio (Regra Cargo)' =
			
			VAR CargoSel     = SELECTEDVALUE(Eixo_Colaboradores[Cargo])
			VAR CargoSelNorm0= UPPER(TRIM(CargoSel))
			VAR CargoSelNorm =
			    SUBSTITUTE(
			    SUBSTITUTE(
			    SUBSTITUTE(
			    SUBSTITUTE(
			    SUBSTITUTE(
			    SUBSTITUTE(
			    SUBSTITUTE(
			    SUBSTITUTE(
			    SUBSTITUTE(
			    SUBSTITUTE(
			    SUBSTITUTE(
			    SUBSTITUTE(CargoSelNorm0,"Á","A"),"À","A"),"Â","A"),"Ã","A"),"É","E"),
			    "Ê","E"),"Í","I"),"Ó","O"),"Ô","O"),"Õ","O"),"Ú","U"),"Ü","U")
			VAR PoloRegra    = SELECTEDVALUE(Eixo_Colaboradores[Polo Base (Regra)])
			VAR MatriculaSel = SELECTEDVALUE(Eixo_Colaboradores[Matricula])
			VAR MatSelTxt    = FORMAT(MatriculaSel, "")
			VAR NomeNormSel  = SELECTEDVALUE(Eixo_Colaboradores[Nome_Normalizado])
			VAR IsMatrizSel  = COALESCE(SELECTEDVALUE(Eixo_Colaboradores[IsMatriz]), FALSE())
			
			VAR IsLinha =
			    HASONEVALUE(Eixo_Colaboradores[Nome_Normalizado]) ||
			    HASONEVALUE(Eixo_Colaboradores[Matricula])
			
			VAR FiltroSlicerHierarquia =
			    TREATAS(VALUES(DimHierarquiaSlicer[KeyHierarquia]), FactCSAT[KeyHierarquia])
			
			VAR Polos_Lider =
			    CALCULATETABLE(
			        DISTINCT(FactOS[des_service_provider]),
			        KEEPFILTERS(
			            FILTER(
			                ALL(FactOS[Líder]),
			                VAR n  = UPPER(TRIM(FactOS[Líder]))
			                VAR n1 = SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(n,
			                       "Á","A"),"À","A"),"Â","A"),"Ã","A"),"É","E"),"Ê","E"),"Í","I"),"Ó","O"),"Ô","O"),"Õ","O")
			                VAR n2 = SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(n1,"Ú","U"),"Ü","U"),"Ç","C")
			                RETURN n2 = NomeNormSel
			            )
			        )
			    )
			VAR Polos_Coord =
			    CALCULATETABLE(
			        DISTINCT(FactOS[des_service_provider]),
			        KEEPFILTERS(
			            FILTER(
			                ALL(FactOS[Coordenador.Coordenador]),
			                VAR n  = UPPER(TRIM(FactOS[Coordenador.Coordenador]))
			                VAR n1 = SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(n,
			                       "Á","A"),"À","A"),"Â","A"),"Ã","A"),"É","E"),"Ê","E"),"Í","I"),"Ó","O"),"Ô","O"),"Õ","O")
			                VAR n2 = SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(n1,"Ú","U"),"Ü","U"),"Ç","C")
			                RETURN n2 = NomeNormSel
			            )
			        )
			    )
			
			VAR CoordCtx = SELECTEDVALUE(Eixo_Colaboradores[Coordenador])
			VAR LiderCtx = SELECTEDVALUE(Eixo_Colaboradores[Líder])
			VAR PoloCtx  = SELECTEDVALUE(Eixo_Colaboradores[Polo Base (Regra)])
			
			RETURN
			IF(
			    NOT IsLinha,
			    IF(
			        NOT ISBLANK(PoloCtx) && PoloCtx <> "" && PoloCtx <> "Matriz",
			        CALCULATE(
			            [CSAT Médio Base (Considerar)],
			            REMOVEFILTERS(Eixo_Colaboradores),
			            REMOVEFILTERS(FactCSAT[Matricula2]),
			            REMOVEFILTERS(FactCSAT[des_service_provider]),
			            TREATAS({ PoloCtx }, FactCSAT[des_service_provider]),
			            KEEPFILTERS(FiltroSlicerHierarquia)
			        ),
			        IF(
			            NOT ISBLANK(LiderCtx) && LiderCtx <> "" && LiderCtx <> "Matriz",
			            CALCULATE(
			                [CSAT Médio Base (Considerar)],
			                REMOVEFILTERS(Eixo_Colaboradores),
			                REMOVEFILTERS(FactCSAT[Matricula2]),
			                REMOVEFILTERS(FactCSAT[des_service_provider]),
			                TREATAS({ LiderCtx }, FactCSAT[Líder]),
			                KEEPFILTERS(FiltroSlicerHierarquia)
			            ),
			            IF(
			                NOT ISBLANK(CoordCtx) && CoordCtx <> "" && CoordCtx <> "Matriz",
			                CALCULATE(
			                    [CSAT Médio Base (Considerar)],
			                    REMOVEFILTERS(Eixo_Colaboradores),
			                    REMOVEFILTERS(FactCSAT[Matricula2]),
			                    REMOVEFILTERS(FactCSAT[des_service_provider]),
			                    TREATAS({ CoordCtx }, FactCSAT[Coordenador]),
			                    KEEPFILTERS(FiltroSlicerHierarquia)
			                ),
			                CALCULATE(
			                    [CSAT Médio Base (Considerar)],
			                    REMOVEFILTERS(Eixo_Colaboradores),
			                    REMOVEFILTERS(FactCSAT[Matricula2]),
			                    REMOVEFILTERS(FactCSAT[des_service_provider]),
			                    KEEPFILTERS(FiltroSlicerHierarquia)
			                )
			            )
			        )
			    ),
			    SWITCH(
			        TRUE(),
			        IsMatrizSel,
			            CALCULATE(
			                [CSAT Médio Base (Considerar)],
			                REMOVEFILTERS(Eixo_Colaboradores),
			                REMOVEFILTERS(FactCSAT[Matricula2]),
			                REMOVEFILTERS(FactCSAT[des_service_provider]),
			                KEEPFILTERS(FiltroSlicerHierarquia)
			            ),
			
			        CONTAINSSTRING(CargoSelNorm, "TECNICO") && NOT ISBLANK(MatriculaSel),
			            CALCULATE(
			                [CSAT Médio Base (Considerar)],
			                KEEPFILTERS(FactCSAT[STATUS] = "Considerar"),
			                KEEPFILTERS(
			                    FILTER(
			                        ALL(FactCSAT),
			                        FORMAT(FactCSAT[Matricula2], "") = MatSelTxt
			                    )
			                ),
			                KEEPFILTERS(FiltroSlicerHierarquia)
			            ),
			
			        CONTAINSSTRING(CargoSelNorm, "ASSISTENTE") && NOT ISBLANK(PoloRegra),
			            CALCULATE(
			                [CSAT Médio Base (Considerar)],
			                REMOVEFILTERS(Eixo_Colaboradores),
			                REMOVEFILTERS(FactCSAT[Matricula2]),
			                REMOVEFILTERS(FactCSAT[des_service_provider]),
			                TREATAS({ PoloRegra }, FactCSAT[des_service_provider]),
			                KEEPFILTERS(FiltroSlicerHierarquia)
			            ),
			
			        CONTAINSSTRING(CargoSelNorm, "LIDER") && NOT ISEMPTY(Polos_Lider),
			            CALCULATE(
			                [CSAT Médio Base (Considerar)],
			                REMOVEFILTERS(Eixo_Colaboradores),
			                REMOVEFILTERS(FactCSAT[Matricula2]),
			                TREATAS(Polos_Lider, FactCSAT[des_service_provider]),
			                KEEPFILTERS(FiltroSlicerHierarquia)
			            ),
			        CONTAINSSTRING(CargoSelNorm, "COORDENADOR") && NOT ISEMPTY(Polos_Coord),
			            CALCULATE(
			                [CSAT Médio Base (Considerar)],
			                REMOVEFILTERS(Eixo_Colaboradores),
			                REMOVEFILTERS(FactCSAT[Matricula2]),
			                TREATAS(Polos_Coord, FactCSAT[des_service_provider]),
			                KEEPFILTERS(FiltroSlicerHierarquia)
			            ),
			
			        CALCULATE(
			            [CSAT Médio Base (Considerar)],
			            KEEPFILTERS(FiltroSlicerHierarquia)
			        )
			    )
			)
		lineageTag: 7d12b9ca-6216-4221-9ac3-978ee88fd224

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'DEBUG – Técnico 03/04 (contagem)' =
			
			VAR MatSelTxt = FORMAT(SELECTEDVALUE(Eixo_Colaboradores[Matricula]), "")
			VAR OS_rows =
			    CALCULATE(
			        COUNTROWS(FactOS),
			        KEEPFILTERS( FILTER(ALL(FactOS), FORMAT(FactOS[Matricula], "") = MatSelTxt) )
			    )
			VAR CSAT_rows =
			    CALCULATE(
			        COUNTROWS(FactCSAT),
			        KEEPFILTERS(FactCSAT[STATUS] = "Considerar"),
			        KEEPFILTERS( FILTER(ALL(FactCSAT), FORMAT(FactCSAT[Matricula2], "") = MatSelTxt) )
			    )
			RETURN "OS=" & OS_rows & " | CSAT=" & CSAT_rows
		lineageTag: 04ad3cdd-b2f2-4929-ac16-d2a73d75a382

