			        ISBLANK(Cargo) || ISBLANK(MatriculaAtual),
			        BLANK(),
			        IF(
			            Cargo = "Técnico",
			            // TÉCNICO: individual
			            CALCULATE(AVERAGE(FactOS[pct_ordens_com_ativacao])),
			            
			            IF(
			                Cargo = "Assistente",
			                // ASSISTENTE: média do polo dele (usando DimColaboradores[Polo])
			                IF(
			                    ISBLANK(PoloAtual),
			                    BLANK(),
			                    CALCULATE(
			                        AVERAGE(FactOS[pct_ordens_com_ativacao]),
			                        FILTER(
			                            FactOS,
