table DimColaboradores
	excludeFromModelRefresh
	lineageTag: 119099d0-2e54-4aa6-a4b3-e78cbf7ff0a5

	measure SLA_Dentro_Prazo_Final = ```
			
			VAR Cargo = 
			    IF(
			        HASONEVALUE(DimColaboradores[Cargo]),
			        VALUES(DimColaboradores[Cargo]),
			        BLANK()
			    )
			VAR MatriculaAtual = 
			    IF(
			        HASONEVALUE(DimColaboradores[Matricula]),
			        VALUES(DimColaboradores[Matricula]),
			        BLANK()
			    )
			VAR NomeAtual = 
			    IF(
			        HASONEVALUE(DimColaboradores[Nome]),
			        VALUES(DimColaboradores[Nome]),
			        BLANK()
			    )
			VAR PoloAtual = 
			    IF(
			        HASONEVALUE(DimColaboradores[Polo]),
			        VALUES(DimColaboradores[Polo]),
			        BLANK()
			    )
			RETURN
			    IF(
			        ISBLANK(Cargo) || ISBLANK(MatriculaAtual),
			        BLANK(),
			        IF(
			            Cargo = "Técnico",
			            // TÉCNICO: individual
			            CALCULATE(AVERAGE(FactOS[pct_ordens_dentro_do_prazo_calculado])),
			            
			            IF(
			                Cargo = "Assistente",
			                // ASSISTENTE: média do polo dele (usando DimColaboradores[Polo])
			                IF(
			                    ISBLANK(PoloAtual),
			                    BLANK(),
			                    CALCULATE(
			                        AVERAGE(FactOS[pct_ordens_dentro_do_prazo_calculado]),
			                        FILTER(
			                            FactOS,
			                            FactOS[Matricula] IN 
			                                FILTER(
			                                    CALCULATETABLE(
			                                        VALUES(DimColaboradores[Matricula]),
			                                        DimColaboradores[Cargo] = "Técnico",
			                                        DimColaboradores[Polo] = PoloAtual
			                                    ),
			                                    1=1
			                                )
			                        )
			                    )
			                ),
			                
			                IF(
			                    Cargo = "Líder",
			                    // LÍDER: média dos polos vinculados a ele (via FactOS)
			                    VAR PolosDoLider = 
			                        CALCULATETABLE(
			                            DISTINCT(FactOS[des_service_provider]),
			                            FactOS[Líder] = NomeAtual,
			                            FactOS[des_service_provider] <> BLANK()
			                        )
			                    RETURN
			                        IF(
			                            COUNTROWS(PolosDoLider) = 0,
			                            BLANK(),
			                            VAR SLA_Polos = 
			                                ADDCOLUMNS(
			                                    PolosDoLider,
			                                    "@SLA",
			                                        VAR PoloAux = [des_service_provider]
			                                        RETURN
			                                            CALCULATE(
			                                                AVERAGE(FactOS[pct_ordens_dentro_do_prazo_calculado]),
			                                                FILTER(
			                                                    FactOS,
			                                                    FactOS[Matricula] IN 
			                                                        FILTER(
			                                                            CALCULATETABLE(
			                                                                VALUES(DimColaboradores[Matricula]),
			                                                                DimColaboradores[Cargo] = "Técnico"
			                                                            ),
			                                                            CALCULATE(
			                                                                SELECTEDVALUE(FactOS[des_service_provider])
			                                                            ) = PoloAux
			                                                        )
			                                                )
			                                            )
			                                )
			                            RETURN
			                                AVERAGEX(SLA_Polos, [@SLA])
			                        ),
			                    
			                    IF(
			                        Cargo = "Coordenador",
			                        // COORDENADOR: média dos líderes vinculados a ele (via FactOS)
			                        VAR LideresDoCoordenador = 
			                            CALCULATETABLE(
			                                DISTINCT(FactOS[Líder]),
			                                FactOS[Coordenador.Coordenador] = NomeAtual,
			                                FactOS[Líder] <> BLANK()
			                            )
			                        RETURN
			                            IF(
			                                COUNTROWS(LideresDoCoordenador) = 0,
			                                BLANK(),
			                                VAR SLA_Lideres = 
			                                    ADDCOLUMNS(
			                                        LideresDoCoordenador,
			                                        "@SLA",
			                                            VAR LiderAux = [Líder]
			                                            VAR PolosDoLiderAux = 
			                                                CALCULATETABLE(
			                                                    DISTINCT(FactOS[des_service_provider]),
			                                                    FactOS[Líder] = LiderAux,
			                                                    FactOS[des_service_provider] <> BLANK()
			                                                )
			                                            VAR SLA_PolosAux = 
			                                                ADDCOLUMNS(
			                                                    PolosDoLiderAux,
			                                                    "@SLA_Polo",
			                                                        VAR PoloAux2 = [des_service_provider]
			                                                        RETURN
			                                                            CALCULATE(
			                                                                AVERAGE(FactOS[pct_ordens_dentro_do_prazo_calculado]),
			                                                                FILTER(
			                                                                    FactOS,
			                                                                    FactOS[Matricula] IN 
			                                                                        FILTER(
			                                                                            CALCULATETABLE(
			                                                                                VALUES(DimColaboradores[Matricula]),
			                                                                                DimColaboradores[Cargo] = "Técnico"
			                                                                            ),
			                                                                            CALCULATE(
			                                                                                SELECTEDVALUE(FactOS[des_service_provider])
			                                                                            ) = PoloAux2
			                                                                        )
			                                                                )
			                                                            )
			                                                )
			                                            RETURN
			                                                AVERAGEX(SLA_PolosAux, [@SLA_Polo])
			                                        )
			                                RETURN
			                                    AVERAGEX(SLA_Lideres, [@SLA])
			                            ),
			                        
			                        // Matriz/Admin: total geral
			                        AVERAGE(FactOS[pct_ordens_dentro_do_prazo_calculado])
			                    )
			                )
			            )
			        )
			    )
			```
		lineageTag: d34846ee-ac02-4487-aa60-84166c9315f0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Ativacao_Percentual_Final = ```
			
