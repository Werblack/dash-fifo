			                        )
			                    )
			                ),
			                
			                IF(
			                    Cargo = "Líder",
			                    // LÍDER: média dos polos vinculados a ele (via FactOS)
			                    VAR PolosDoLider = 
			                        CALCULATETABLE(
			                            DISTINCT(FactOS[des_service_provider]),
			                            FactOS[Líder] = NomeAtual,
			                            FactOS[des_service_provider] <> BLANK()
			                        )
			                    RETURN
			                        IF(
			                            COUNTROWS(PolosDoLider) = 0,
			                            BLANK(),
			                            VAR Ativacao_Polos = 
			                                ADDCOLUMNS(
			                                    PolosDoLider,
			                                    "@Ativacao",
			                                        VAR PoloAux = [des_service_provider]
			                                        RETURN
			                                            CALCULATE(
			                                                AVERAGE(FactOS[pct_ordens_com_ativacao]),
			                                                FILTER(
			                                                    FactOS,
			                                                    FactOS[Matricula] IN 
			                                                        FILTER(
			                                                            CALCULATETABLE(
			                                                                VALUES(DimColaboradores[Matricula]),
			                                                                DimColaboradores[Cargo] = "Técnico"
			                                                            ),
			                                                            CALCULATE(
			                                                                SELECTEDVALUE(FactOS[des_service_provider])
			                                                            ) = PoloAux
			                                                        )
			                                                )
			                                            )
			                                )
			                            RETURN
			                                AVERAGEX(Ativacao_Polos, [@Ativacao])
			                        ),
			                    
			                    IF(
			                        Cargo = "Coordenador",
			                        // COORDENADOR: média dos líderes vinculados a ele (via FactOS)
			                        VAR LideresDoCoordenador = 
			                            CALCULATETABLE(
			                                DISTINCT(FactOS[Líder]),
			                                FactOS[Coordenador.Coordenador] = NomeAtual,
			                                FactOS[Líder] <> BLANK()
			                            )
			                        RETURN
			                            IF(
			                                COUNTROWS(LideresDoCoordenador) = 0,
			                                BLANK(),
			                                VAR Ativacao_Lideres = 
			                                    ADDCOLUMNS(
			                                        LideresDoCoordenador,
			                                        "@Ativacao",
			                                            VAR LiderAux = [Líder]
			                                            VAR PolosDoLiderAux = 
			                                                CALCULATETABLE(
			                                                    DISTINCT(FactOS[des_service_provider]),
			                                                    FactOS[Líder] = LiderAux,
			                                                    FactOS[des_service_provider] <> BLANK()
			                                                )
			                                            VAR Ativacao_PolosAux = 
			                                                ADDCOLUMNS(
			                                                    PolosDoLiderAux,
			                                                    "@Ativacao_Polo",
			                                                        VAR PoloAux2 = [des_service_provider]
			                                                        RETURN
			                                                            CALCULATE(
			                                                                AVERAGE(FactOS[pct_ordens_com_ativacao]),
			                                                                FILTER(
			                                                                    FactOS,
			                                                                    FactOS[Matricula] IN 
			                                                                        FILTER(
			                                                                            CALCULATETABLE(
			                                                                                VALUES(DimColaboradores[Matricula]),
			                                                                                DimColaboradores[Cargo] = "Técnico"
			                                                                            ),
			                                                                            CALCULATE(
			                                                                                SELECTEDVALUE(FactOS[des_service_provider])
			                                                                            ) = PoloAux2
			                                                                        )
			                                                                )
			                                                            )
			                                                )
			                                            RETURN
			                                                AVERAGEX(Ativacao_PolosAux, [@Ativacao_Polo])
			                                        )
			                                RETURN
			                                    AVERAGEX(Ativacao_Lideres, [@Ativacao])
			                            ),
			                        
			                        // Matriz/Admin: total geral
			                        AVERAGE(FactOS[pct_ordens_com_ativacao])
			                    )
			                )
			            )
			        )
