	measure CSAT_Polo = ```
			
			VAR MatriculaAtual = SELECTEDVALUE(DimColaboradores[Matricula])
			VAR PoloAtual = 
			    CALCULATE(
			        SELECTEDVALUE(FactOS[des_service_provider]),
			        DimColaboradores[Matricula] = MatriculaAtual
			    )
			RETURN
			    IF(
			        ISBLANK(PoloAtual),
			        BLANK(),
			        VAR MatriculasTecnicos = 
			            CALCULATETABLE(
			                DISTINCT(DimColaboradores[Matricula]),
			                DimColaboradores[Cargo] = "Técnico"
			            )
			        RETURN
			            CALCULATE(
			                AVERAGE(FactCSAT[nota_pesquisa]),
			                FactCSAT[des_service_provider] = PoloAtual,
			                FactCSAT[Matricula] IN MatriculasTecnicos
			            )
			    )
			```
		lineageTag: 94d900e1-dfe7-47f9-b0ac-7605bc7a552a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure CSAT_Teste_Simples = ```
			
			VAR Cargo = 
			    IF(
			        HASONEVALUE(DimColaboradores[Cargo]),
			        VALUES(DimColaboradores[Cargo]),
			        BLANK()
			    )
			VAR PoloAtual = 
			    IF(
			        HASONEVALUE(DimColaboradores[Polo]),
			        VALUES(DimColaboradores[Polo]),
			        BLANK()
			    )
			RETURN
			    IF(
			        Cargo = "Técnico",
			        "É TÉCNICO",
			        IF(
			            Cargo = "Assistente",
			            "É ASSISTENTE - Polo: " & IF(ISBLANK(PoloAtual), "SEM POLO", PoloAtual),
			            IF(
			                Cargo = "Líder",
			                "É LÍDER",
			                IF(
			                    Cargo = "Coordenador",
			                    "É COORDENADOR",
			                    "OUTRO CARGO"
			                )
			            )
			        )
			    )
			```
