	partition Revisita_Consolidado = m
		mode: import
		source =
				let
				    Combinado =
				        Table.Combine({
				            Revisita_HISTORICO,
				            Revisita_ATUAL
				        }),
				    UnicoPorOS = Table.Distinct(Combinado, {"OS_ID"})
				in
				    UnicoPorOS

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegação

