	hierarchy Periodo
		lineageTag: d70d6098-464c-4123-a386-6d4f7dfb2a81

		level Ano
			lineageTag: 1948da23-bbbc-4f1b-a8fb-c814b5ed2945
			column: Ano

		level Mes
			lineageTag: 1f63e3df-22ed-4145-999b-80aa7fdb905c
			column: Mes

		level SemanaAno
			lineageTag: 219c6248-f694-4c87-9e31-0112124c40dc
			column: SemanaAno

		level Date
			lineageTag: c649baa5-f4e2-41a2-bd01-13d200c20533
