table DimCalendario
	excludeFromModelRefresh
	lineageTag: e1518dd8-7710-45b7-ac49-3cf8806452ea

	measure TemDadosPeriodo =
			
			VAR qtde =
			    CALCULATE ( [Total_OS] )   -- respeita o filtro do eixo (mês/semana/dia)
			RETURN
			    IF ( qtde > 0, 1, 0 )
		formatString: 0
		lineageTag: b4746a00-90df-49ad-823d-9ba3d32887aa

	column Date
		dataType: dateTime
		formatString: dd/mm/yyyy
