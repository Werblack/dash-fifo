		variation Variation
			isDefault
			relationship: 98fc7cd5-6c8b-4ed0-a2d4-d91de4842026
			defaultHierarchy: LocalDateTable_4eb6e002-2108-478b-945b-026e1db05419.'Hierarquia de datas'

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

