	hierarchy PeriodoMulti
		lineageTag: f10e9a91-6f1a-4f8a-ba30-ff430bdc5867

		level Mes
			lineageTag: db346b7a-2f95-4b7a-9499-f0f69dd80e16
			column: Mes

		level SemanaAno
			lineageTag: a3b9c4e6-14c9-4cbc-a505-8e83b372523a
			column: SemanaAno

