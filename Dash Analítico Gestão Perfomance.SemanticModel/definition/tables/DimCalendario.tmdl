			lineageTag: a9044e4d-ce9f-4b78-8586-fdcddf346f62
			column: DiaNumero

	partition DimCalendario = m
		mode: import
		source =
				let
				    DataInicial = #date(2024, 1, 1),
				    DataFinal   = #date(2029,12,31),
				
				    NumeroDias  = Duration.Days(DataFinal - DataInicial) + 1,
				    ListaDatas  = List.Dates(DataInicial, NumeroDias, #duration(1,0,0,0)),
				
				    Tabela      = Table.FromList(ListaDatas, Splitter.SplitByNothing(), {"Date"}),
				    TipoData    = Table.TransformColumnTypes(Tabela, {{"Date", type date}}),
				
				    AddAno      = Table.AddColumn(TipoData, "Ano", each Date.Year([Date]), Int64.Type),
				
				    AddMes      = Table.AddColumn(AddAno, "Mes", each Date.ToText([Date], "MMM/yyyy", "pt-BR"), type text),
				    AddMesOrd   = Table.AddColumn(AddMes, "MesOrdenacao", each Date.ToText([Date], "yyyy-MM"), type text),
				    AddAnoMes   = Table.AddColumn(AddMesOrd, "AnoMes", each Text.From([Ano]) & "-" & Text.PadStart(Text.From(Date.Month([Date])), 2, "0"), type text),
				
				    AddSemanaOrd = Table.AddColumn(AddAnoMes, "SemanaOrdenacao", each Text.From([Ano]) & "-" & Text.PadStart(Text.From(Date.WeekOfYear([Date])), 2, "0"), type text),
				    AddSemana    = Table.AddColumn(AddSemanaOrd, "SemanaAno", each "WK-" & Text.PadStart(Text.From(Date.WeekOfYear([Date])), 2, "0"), type text),
				
				    AddDiaNumero = Table.AddColumn(AddSemana, "DiaNumero", each Date.Day([Date]), Int64.Type),
				    AddNomeDia   = Table.AddColumn(AddDiaNumero, "NomeDiaSemana", each Date.ToText([Date], "ddd", "pt-BR"), type text),
				    AddInicioSem = Table.AddColumn(AddNomeDia, "InicioSemana", each Date.StartOfWeek([Date], Day.Monday), type date)
				in
				    AddInicioSem

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

